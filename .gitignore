# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local PostgreSQL data, phone originals, and generated uploads
/data
*.HEIC
*.heic
*.MOV
*.mov
/public/uploads/*
!/public/uploads/.gitkeep
/public/media/*
!/public/media/.gitkeep
!/public/media/*.webp
!/public/media/puzzle/
!/public/media/puzzle/**

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
